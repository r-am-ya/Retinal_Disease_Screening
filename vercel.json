{
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": "public",
  "functions": {
    "api/predict.py": {
      "includeFiles": "api/{model.onnx,class_names.json}",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}